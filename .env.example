# Required for chat / RAG / optional voice transcription
OPENAI_API_KEY=

# Optional — OpenAI speech-to-text for “Record with OpenAI” (default whisper-1)
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional — OpenAI models
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4.1-mini

# RAG catalog JSON (path relative to project root; default is data/catalog.generated.5000.json)
# RAG_CATALOG_PATH=data/other-catalog.json

# RAG embeddings cache (recommended): persist embedded chunks to disk so restarts don’t re-index
RAG_EMBED_CACHE=1

# Tech product REST API (run `npm run dev:catalog-api`, default port 4001)
# Required for Next.js BFF routes under /api/catalog/v1/*
CATALOG_API_BASE_URL=http://127.0.0.1:4001

# Optional — same bearer token on catalog-api and Next
# CATALOG_API_TOKEN=

# catalog-api only — paths relative to services/catalog-api when you cd there
# CATALOG_DB_PATH=../../data/catalog.sqlite
# CATALOG_SEED_PATH=../../data/catalog.generated.5000.json
# CATALOG_FORCE_RESEED=1

# catalog-api only — Redis inventory (optional). When set, product JSON includes `inStock`.
# REDIS_URL=redis://127.0.0.1:6379
# CATALOG_INVENTORY_SEED=1
# CATALOG_INVENTORY_DEFAULT_QTY=10
# CATALOG_INVENTORY_KEY_PREFIX=catalog:inventory
